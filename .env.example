# オンライン連携（7-4）。値は Cloudflare Pages の環境変数に入れる（ローカルで試すときだけ .env に写す）。
# 無ければオフライン（連携の UI は出ず、全モードがローカルで動く）。
# service_role key / secret key（sb_secret_...）は絶対に入れない
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# OGP の og:image を絶対 URL にする公開の URL（8-5。任意。無ければ Cloudflare Pages の CF_PAGES_URL、それも無ければパスだけ）
VITE_SITE_URL=
