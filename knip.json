{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.js", "scripts/bench-*.ts", "tests/state-dump.ts", "src/ui/card/og-image.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.{ts,js}", "tests/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": [
    "/src/ui/toast.ts",
    "/src/core/i18n.ts",
    "/src/progression/paint.ts",
    "/src/data/aircraft.ts",
    "/src/data/card.ts",
    "/src/ui/card/card-canvas.ts",
    "/src/ui/card/card-model.ts",
    "/src/ui/card/og-image.ts",
    "/src/ui/member-settings.ts",
    "/src/ui/online-settings.ts",
    "/src/ui/card/card-dialog.ts",
    "/src/core/viewport-fit.ts"
  ]
}
